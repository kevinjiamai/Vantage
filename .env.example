# Client build values. These are compiled into the browser bundle and are
# therefore public by nature - never put a real secret here.
#
# Copy to .env for local development. In production set them in the Vercel
# dashboard rather than committing a .env.production.

# Backend origin. Leave empty on Vercel so /api uses the rewrite in vercel.json;
# set it only when you want the browser to call the API host directly.
VITE_API_BASE_URL=
