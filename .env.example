# Client build values. These are compiled into the browser bundle and are
# therefore public by nature - never put a real secret here.
#
# Copy to .env for local development. Nothing here is required to run locally.

# Backend origin. Leave empty to use the Vite dev proxy (or, in production, a
# same-origin rewrite). Set it only when the browser should call the API host
# directly - see docs/OPERATING.md.
VITE_API_BASE_URL=

# Server configuration (SECRET_KEY, DATABASE_URL, LLM_*) is NOT set here.
# It belongs on the API service. See docs/OPERATING.md.
